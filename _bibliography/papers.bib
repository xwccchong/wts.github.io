@article{wu2026lada,
  title     = {Language-Grounded Decoupled Action Representation for Robotic Manipulation},
  author    = {Wu, Tongshu and Wang, Z.},
  year      = {2026},
  journal   = {CVPR},
  abbr      = {CVPR},
  selected  = {true},
  abstract  = {Proposed LaDA framework that maps continuous 7-DoF control into Translation, Rotation, and Gripper primitives via language-driven action decoupling. Designed Semantic-Guided Soft-Label Contrastive Learning for cross-task semantic alignment. Achieved 93.6\% average success rate on LIBERO with only 0.6B parameters, outperforming larger VLA models. Successfully deployed on Franka Panda real robot.},
  bibtex_show = {true}
}

@inproceedings{wu2025fast,
  title     = {Fast Policy: Accelerating Visuomotor Policies without Re-training},
  author    = {Wu, Tongshu and Wang, Z.},
  year      = {2025},
  booktitle = {2025 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)},
  address   = {Hangzhou, China},
  abbr      = {IROS},
  selected  = {true},
  abstract  = {Proposed a training-free acceleration framework for diffusion models in visuomotor policies. Dynamically reuses encoder features and applies noise correction to eliminate redundant computation in non-critical denoising steps. Reduced single inference latency to ~80ms (2x speedup over DDIM) on ToolHang and other complex tasks with no performance degradation.},
  bibtex_show = {true}
}
